# Discord Bot のトークン（Discord Developer Portal で発行）
DISCORD_TOKEN=

# Discord アプリケーションの Client ID（スラッシュコマンド登録に使用）
DISCORD_CLIENT_ID=

# 開発時にスラッシュコマンドを即時反映させたい場合、対象サーバーのGuild IDを指定する。
# 空欄の場合はグローバルコマンドとして登録される（反映まで最大1時間程度かかる）。
DISCORD_GUILD_ID=

# 地震速報の通知先チャンネルID（任意 — 未指定でも起動可。/config channel set コマンドでも設定可能）
EARTHQUAKE_CHANNEL_ID=

# 気象警報・注意報の通知先チャンネルID（任意 — 未指定でも起動可。/config channel set コマンドでも設定可能）
WARNING_CHANNEL_ID=

# 任意設定（未指定時は config.json の値を使用）
# JMA_POLLING_INTERVAL_MINUTES=5
# EARTHQUAKE_MIN_SCALE=40
